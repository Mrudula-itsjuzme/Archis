# Copy this file to .env and fill in real values. .env is gitignored.

# Gemini
VITE_GEMINI_API_KEY=       # legacy/client-facing Gemini key, where still referenced
GEMINI_API_KEY=            # server-side key used by Vercel API routes (api/extract.ts, api/recommendations.ts)

# Firebase (src/lib/firebase.ts) — all required except MEASUREMENT_ID
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=      # optional, Analytics only
